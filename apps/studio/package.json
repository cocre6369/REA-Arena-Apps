{
  "name": "chroma-studio",
  "version": "0.1.0",
  "description": "Chroma Studio \u2014 an independent image editor (Electron)",
  "main": "desktop/main.js",
  "author": "Chroma Studio",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron .",
    "serve": "node tools/serve.cjs",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --dir --win --x64",
    "dist:portable": "electron-builder --win --x64 --config.win.target=portable",
    "dist:linux": "electron-builder --linux --x64",
    "postinstall": "echo ok"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "studio.chroma.app",
    "productName": "Chroma Studio",
    "copyright": "Copyright \u00a9 Chroma Studio",
    "directories": {
      "output": "dist",
      "buildResources": "desktop"
    },
    "files": [
      "index.html",
      "src/**/*",
      "styles/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Chroma Studio",
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "desktop/icon.png"
    },
    "compression": "maximum",
    "asar": true,
    "fileAssociations": [
      {
        "ext": "csp",
        "name": "Chroma Studio Project",
        "role": "Editor"
      }
    ]
  }
}
